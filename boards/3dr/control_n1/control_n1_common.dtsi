#include <st/h7/stm32h743Xi.dtsi>
#include <st/h7/stm32h743v(g-i)hx-pinctrl.dtsi>
#include "control_n1_connector.dtsi"

/ {
	model = "3DR Control N1";

	chosen {
		zephyr,console = &uart7;
		zephyr,shell-uart = &uart7;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,dtcm = &dtcm;
		zephyr,itcm = &itcm;
		zephyr,canbus = &fdcan1;
	};

	/* The WS2812B RGB LED on PB1 (TIM3_CH4) is not supported yet. */
	leds {
		compatible = "gpio-leds";

		blue_led: led_0 {
			gpios = <&gpiod 10 GPIO_ACTIVE_HIGH>;
			label = "Blue LED";
		};
	};

	buzzer: buzzer {
		compatible = "pwm-buzzer";
		pwms = <&pwm17 1 PWM_HZ(2700) PWM_POLARITY_NORMAL>;
	};

	aliases {
		led0 = &blue_led;
		buzzer0 = &buzzer;
		magn0 = &ak09940a;
		sdhc0 = &sdmmc1;
		watchdog0 = &iwdg;
	};
};

&clk_hsi48 {
	status = "okay";
};

&clk_hse {
	hse-bypass;
	clock-frequency = <DT_FREQ_M(24)>;
	status = "okay";
};

&pll {
	div-m = <3>;
	mul-n = <120>;
	div-p = <2>;
	div-q = <5>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

/* 80 MHz FDCAN kernel clock */
&pll2 {
	div-m = <3>;
	mul-n = <60>;
	div-p = <2>;
	div-q = <6>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

/* 48 MHz USB clock */
&pll3 {
	div-m = <3>;
	mul-n = <48>;
	div-p = <2>;
	div-q = <8>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(480)>;
	d1cpre = <1>;
	hpre = <2>;
	d1ppre = <2>;
	d2ppre1 = <2>;
	d2ppre2 = <2>;
	d3ppre = <2>;
};

&pwr {
	power-supply = "ldo";
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart2 {
	pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6 &usart2_cts_pd3 &usart2_rts_pd4>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart3 {
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&uart4 {
	pinctrl-0 = <&uart4_tx_pd1 &uart4_rx_pd0 &uart4_cts_pb0 &uart4_rts_pa15>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart6 {
	pinctrl-0 = <&usart6_tx_pc6 &usart6_rx_pc7>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&uart7 {
	pinctrl-0 = <&uart7_tx_pe8 &uart7_rx_pe7 &uart7_cts_pe10 &uart7_rts_pe9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&uart8 {
	pinctrl-0 = <&uart8_tx_pe1 &uart8_rx_pe0>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";

	ak09940a: magnetometer@c {
		compatible = "asahi-kasei,ak09940a";
		reg = <0x0c>;
	};
};

&i2c2 {
	pinctrl-0 = <&i2c2_scl_pb10 &i2c2_sda_pb11>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pd7>;
	pinctrl-names = "default";
	st,gpio-control;
	cs-gpios = <&gpioe 12 GPIO_ACTIVE_LOW>;
	status = "okay";

	/* CS0: IIM-42653 IMU, not supported yet */
};

&spi2 {
	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pc2_c &spi2_mosi_pc1>;
	pinctrl-names = "default";
	st,gpio-control;
	cs-gpios = <&gpioe 15 GPIO_ACTIVE_LOW>;
	status = "okay";

	/* CS0: IIM-42653 IMU, not supported yet */
};

&spi4 {
	pinctrl-0 = <&spi4_sck_pe2 &spi4_miso_pe5 &spi4_mosi_pe6>;
	pinctrl-names = "default";
	st,gpio-control;
	cs-gpios = <&gpiob 2 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&spi6 {
	pinctrl-0 = <&spi6_sck_pb3 &spi6_miso_pb4 &spi6_mosi_pb5>;
	pinctrl-names = "default";
	st,gpio-control;
	cs-gpios = <&gpioe 3 GPIO_ACTIVE_LOW>, <&gpioc 13 GPIO_ACTIVE_LOW>;
	status = "okay";

	/*
	 * CS0: DPS368 barometer, not supported on SPI yet
	 * CS1: M95P08 page EEPROM, not supported yet
	 */
};

&fdcan1 {
	pinctrl-0 = <&fdcan1_rx_pa11 &fdcan1_tx_pa12>;
	pinctrl-names = "default";
	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
		 <&rcc STM32_SRC_PLL2_Q FDCAN_SEL(2)>;
	status = "okay";

	can-transceiver {
		max-bitrate = <8000000>;
	};
};

&fdcan2 {
	pinctrl-0 = <&fdcan2_rx_pb12 &fdcan2_tx_pb6>;
	pinctrl-names = "default";
	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
		 <&rcc STM32_SRC_PLL2_Q FDCAN_SEL(2)>;
	status = "okay";

	can-transceiver {
		max-bitrate = <8000000>;
	};
};

/* Timers run at 240 MHz: a prescaler of 239 gives 1 us PWM resolution. */
&timers1 {
	st,prescaler = <239>;
	status = "okay";

	pwm1: pwm {
		pinctrl-0 = <&tim1_ch1_pa8 &tim1_ch2_pe11 &tim1_ch3_pe13 &tim1_ch4_pe14>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&timers2 {
	st,prescaler = <239>;
	status = "okay";

	pwm2: pwm {
		pinctrl-0 = <&tim2_ch1_pa0 &tim2_ch2_pa1 &tim2_ch3_pa2 &tim2_ch4_pa3>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&timers4 {
	st,prescaler = <239>;
	status = "okay";

	pwm4: pwm {
		pinctrl-0 = <&tim4_ch1_pd12 &tim4_ch2_pd13 &tim4_ch3_pd14 &tim4_ch4_pd15>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&timers17 {
	st,prescaler = <239>;
	status = "okay";

	pwm17: pwm {
		pinctrl-0 = <&tim17_ch1_pb9>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&adc12_common {
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";
};

&adc1 {
	pinctrl-0 = <&adc1_inp8_pc5 &adc1_inp10_pc0 &adc1_inp18_pa4>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	/* 5 V supply sense, divided by 2 */
	channel@8 {
		reg = <8>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <16>;
	};

	channel@a {
		reg = <10>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <16>;
	};

	channel@12 {
		reg = <18>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <16>;
	};
};

&sdmmc1 {
	pinctrl-0 = <&sdmmc1_d0_pc8 &sdmmc1_d1_pc9
		     &sdmmc1_d2_pc10 &sdmmc1_d3_pc11
		     &sdmmc1_ck_pc12 &sdmmc1_cmd_pd2>;
	pinctrl-names = "default";
	bus-width = <4>;
	disk-name = "SD";
	status = "okay";
};

zephyr_udc0: &usbotg_hs {
	pinctrl-0 = <&usb_otg_hs_dm_pb14 &usb_otg_hs_dp_pb15>;
	pinctrl-names = "default";
	clocks = <&rcc STM32_CLOCK(AHB1, 25)>,
		 <&rcc STM32_SRC_PLL3_Q USB_SEL(2)>;
	status = "okay";
};

&iwdg {
	status = "okay";
};

&rng {
	status = "okay";
};
